# Dental Hub CRM - environment template
#
# Copy to .env and fill in. NEVER commit a real .env: .gitignore excludes
# .env* and explicitly re-includes only this template.
#
# One-time local PostgreSQL setup (as a superuser, once per machine):
#
#   CREATE ROLE dental_hub_crm LOGIN PASSWORD '<choose a local dev password>' CREATEDB;
#   CREATE DATABASE dental_hub_crm OWNER dental_hub_crm;
#
# CREATEDB is what lets the foundation suite create and drop its own disposable
# test databases. The superuser password is never needed by this application.

# Canonical application database.
DATABASE_URL=postgresql://dental_hub_crm:CHANGE_ME@127.0.0.1:5432/dental_hub_crm

# Maintenance connection used ONLY by the test suite, to CREATE/DROP disposable
# databases named dental_hub_crm_test_<hex>. Must NOT point at a real database.
TEST_ADMIN_DATABASE_URL=postgresql://dental_hub_crm:CHANGE_ME@127.0.0.1:5432/postgres

# Absolute session lifetime in hours. Default 12 when unset.
SESSION_TTL_HOURS=12

# Development-only password given to the three synthetic seed operators
# (admin@dentalhub.test, manager@dentalhub.test, rep@dentalhub.test).
# Development convenience only - never use in any deployed environment.
SEED_DEV_PASSWORD=DentalHubDev!2024
